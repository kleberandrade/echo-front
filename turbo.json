{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_ECHO_API", "NEXT_PUBLIC_ECHO_WS", "NEXT_PUBLIC_SITE_URL"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["NEXT_PUBLIC_ECHO_API", "NEXT_PUBLIC_ECHO_WS", "NEXT_PUBLIC_SITE_URL"],
      "passThroughEnv": ["PORT", "DATABASE_URL", "ECHO_DEMO_ENABLED", "ECHO_WEB_ORIGIN"]
    },
    "@echo-front/sim#test": {
      "dependsOn": ["build"]
    }
  }
}
