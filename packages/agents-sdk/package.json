{
  "name": "@echo-front/agents-sdk",
  "version": "0.1.0",
  "description": "SDK e bots de referência para escrever agentes do ECHO//FRONT.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "match": "node dist/harness.js",
    "batch": "node dist/batch.js",
    "agent:check": "node dist/check.js"
  },
  "dependencies": {
    "@echo-front/protocol": "workspace:*",
    "@echo-front/sim": "workspace:*",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "keywords": [
    "echo-front",
    "ai-agents",
    "bot-sdk",
    "websocket"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kleberandrade/echo-front.git",
    "directory": "packages/agents-sdk"
  },
  "homepage": "https://github.com/kleberandrade/echo-front/tree/main/packages/agents-sdk#readme",
  "bugs": "https://github.com/kleberandrade/echo-front/issues",
  "author": "Kleber Andrade",
  "publishConfig": {
    "access": "public"
  }
}
