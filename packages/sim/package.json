{
  "name": "@echo-front/sim",
  "version": "0.6.0",
  "description": "Simulador determin\u00edstico da arena t\u00e1tica do ECHO//FRONT \u2014 movimento, sensores com ru\u00eddo reproduz\u00edvel, fog com envelhecimento.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sim:run": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@echo-front/protocol": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
