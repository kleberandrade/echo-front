{
  "name": "@echo-front/sim",
  "version": "0.6.0",
  "description": "Simulador determinístico da arena tática do ECHO//FRONT — movimento, sensores com ruído reproduzível, fog com envelhecimento.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "sim:run": "node dist/cli.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@echo-front/protocol": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "echo-front",
    "game-simulation",
    "deterministic",
    "ai-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kleberandrade/echo-front.git",
    "directory": "packages/sim"
  },
  "homepage": "https://github.com/kleberandrade/echo-front/tree/main/packages/sim#readme",
  "bugs": "https://github.com/kleberandrade/echo-front/issues",
  "author": "Kleber Andrade",
  "publishConfig": {
    "access": "public"
  }
}
