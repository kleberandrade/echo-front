{
  "name": "@echo-front/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch & node --watch dist/main.js",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tournament": "node dist/tournament.js"
  },
  "dependencies": {
    "@echo-front/protocol": "workspace:*",
    "@echo-front/sim": "workspace:*",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/platform-ws": "^11.2.10",
    "@nestjs/websockets": "^11.2.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.23.0",
    "zod": "^4.6.7",
    "@echo-front/agents-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
