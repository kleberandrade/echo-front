{
  "name": "echo-front-monorepo",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x || 26.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "sim:run": "pnpm --filter @echo-front/sim run sim:run --",
    "sim:batch": "pnpm --filter @echo-front/agents-sdk run batch --",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,mjs,css}\"",
    "prepare": "node -e \"if(!(process.env.VERCEL||process.env.CI)) require('child_process').execSync('husky',{stdio:'inherit'})\"",
    "test:smoke": "pnpm --filter @echo-front/web smoke",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,mjs,css}\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx,md,json,mjs,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.11",
    "typescript": "^5.9.3"
  }
}
